# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).
# Variáveis definidas no terminal têm prioridade sobre este arquivo.

ORACLE_USER=USUARIO_DA_APLICACAO
ORACLE_PASSWORD=SENHA_DO_USUARIO
# Formato: HOST:PORTA/NOME_DO_SERVICO  (ex.: localhost:1521/XEPDB1)
ORACLE_DSN=HOST:1521/NOME_DO_SERVICO

# Opcional: segundos de espera ao conectar (padrão 10)
# ORACLE_TIMEOUT=10
